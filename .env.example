# VisitFlow & Ski Compliance AI Agent Environment Variables

# LLM Providers / API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Default Model Selection (e.g. gpt-4o, claude-3-5-sonnet, gemini-2.0-flash)
DEFAULT_MODEL=gemini-2.5-flash

# Port Configuration
PORT=3000
HOST=0.0.0.0

# Optional Database & Microservice APIs
VISITFLOW_API_URL=
SKI_COMPLIANCE_API_URL=

# MySQL Database Configurations
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE_VISITFLOW=VISITFLOW_MF_PROD
MYSQL_DATABASE_SKI=SKI_MF_PROD

